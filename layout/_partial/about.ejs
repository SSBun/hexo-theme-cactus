<div id="about">
  <% page.data.bookmarks.forEach(section => { %>
    <div class="section">
      <div class="header">
        <%= section.name %>
      </div>
      <div class="container">
        <% section.items.forEach(item => { %>
          <div class="box" onclick="clickBookmark('<%= item.url %>')">
            <img
                class="favicon"
                src="http://www.google.com/s2/favicons?domain=<%= item.url %>">
            <span><%= item.name %></span>
          </div>
        <% }) %>
      </div>
    </div>
  <% }) %>
</div>

<script>
    function clickBookmark(url) {
        window.open(url);
    }
</script>
