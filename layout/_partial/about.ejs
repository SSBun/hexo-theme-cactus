<div id="about">
  <div class="personl-info">
    <%- partial('_partial/ui_utils/flip_card') %>
<!--    <div class="info-container">-->
<!--      <% page.data.personalInfo.forEach(item => { %>-->
<!--        <div class="info-row">-->
<!--          <div class="name"><%= item.label %> :</div>-->
<!--          <div class="content"><%= item.content %></div>-->
<!--        </div>-->
<!--      <% }) %>-->
<!--    </div>-->
  </div>
  <% page.data.bookmarks.forEach(section => { %>
    <div class="section">
      <div class="header">
        <%= section.name %>
      </div>
      <div class="container">
        <% section.items.forEach(item => { %>
          <div class="box" onclick="clickBookmark('<%= item.url %>')">
            <%
              var faviconDomain;
              try { faviconDomain = new URL(item.url).hostname; } catch(e) {}
              var faviconFile = faviconDomain ? '/about/favicons/' + faviconDomain.replace(/[^a-zA-Z0-9.-]/g, '_') + '.png' : '';
              var faviconFallback = 'https://www.google.com/s2/favicons?domain=' + encodeURIComponent(item.url);
            %>
            <img
                class="favicon"
                src="<%= faviconFile %>"
                onerror="this.onerror=null;this.src='<%= faviconFallback %>'"
                alt="">
            <div class="name"><%= item.name %>
              <% if (item.desc) { %>
                <span class="tip"><%= item.desc %></span>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  <% }) %>
</div>

<script>
    function clickBookmark(url) {
        window.open(url);
    }
</script>
