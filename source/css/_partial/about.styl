#about
  .personl-info
    margin-top: 2rem
    display: grid
    grid-template-columns: 16rem 1fr

  .info-container
    display: grid
    grid-gap: 1rem

  .info-row
    height: 3rem
    display: flex
    align-items: center
    background-color: green

    .name
      font-weight: bold
      background-color: blue

    .content
      margin-left: 1rem
      line-height: 3rem
      text-align: center
      background-color: red

  .section
    margin-top: 4rem

    .container
      display: grid
      grid-column-gap: 2rem
      grid-row-gap: 1rem
      grid-template-columns: repeat(2, 50%)

    .header
      height: 50px
      color: $color-accent-1
      font-size: 1.3rem
      font-weight: bold

    .box
      display: flex
      align-items: center
      border-radius: 6px
      background-color: $color-background
      color $color-accent-3

      span
        display inline-block
        overflow: hidden
        white-space: nowrap
        text-overflow: ellipsis
        margin-right 10px

      &:hover
        background-color: $color-background-code

      .favicon
        display: inline-block
        margin-left: 10px
        margin-right: 8px
        width: 1rem
        height: auto


