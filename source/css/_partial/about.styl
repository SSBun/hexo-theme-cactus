#about
  .personl-info
    margin-top: 2rem
    display: grid
    grid-template-columns: 16rem 1fr

  .info-container
    display: grid
    grid-gap: 1rem

  .info-row
    height: 3rem
    display: flex
    align-items: center
    background-color: green

    .name
      font-weight: bold
      background-color: blue

    .content
      margin-left: 1rem
      line-height: 3rem
      text-align: center
      background-color: red

  .section
    margin-top: 2rem

    .header
      height: 40px !important

    .container
      display: grid
      grid-column-gap: 1rem
      grid-row-gap: 0.5rem
      grid-template-columns: repeat(3, 33.3%)

    .header
      height: 50px
      color: $color-accent-1
      font-size: 1.1rem
      font-weight: bold

    .box
      display: flex
      align-items: center
      border-radius: 6px
      background-color: $color-background
      color $color-accent-3

      .name
        display inline-block
        position: relative

      
      .tip
        width: 200px
        pointer-events: none
        color: $color-accent-1
        background-color: $color-background-code
        text-align: center
        border-radius: 6px
        padding: 5px 0
        position: absolute
        z-index: 1
        top: -5px
        left: 110%
        box-shadow: rgba(0, 0, 0, 0.35) 0px 5px 15px
        opacity: 0
        transition: opacity 300ms

      &:hover
        cursor: pointer
        box-shadow: rgba(67, 71, 85, 0.27) 0px 0px 0.25em, rgba(90, 125, 188, 0.05) 0px 0.25em 1em;

      .name:hover
        .tip
          opacity: 1

      .favicon
        display: inline-block
        margin-left: 10px
        margin-right: 8px
        width: 1rem
        height: auto


